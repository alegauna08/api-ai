{
    "version": 2,
    "builds": [
        {
            "src": "main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "main.py"
        }
    ],
    "env": {
        "APP_MODULE": "main:app"
    },
    "functions": {
        "main.py": {
            "runtime": "python3.11"
        }
    }
}
